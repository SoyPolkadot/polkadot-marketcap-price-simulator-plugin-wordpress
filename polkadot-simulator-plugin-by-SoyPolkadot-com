/**
 * Encolar estilos necesarios para el plugin.
 */
function polkadot_simulator_enqueue_assets() {
    wp_register_style('polkadot_simulator_styles', false);
    wp_enqueue_style('polkadot_simulator_styles');
    $custom_css = "
        .polkadot-simulator-form, .polkadot-simulator-results {
            background-color: #f9f9f9;
            padding: 20px;
            border-radius: 5px;
            max-width: 700px;
            margin: 0 auto;
        }
        .polkadot-simulator-form h3, .polkadot-simulator-results h3 {
            margin-top: 0;
        }
        .polkadot-simulator-form p, .polkadot-simulator-results p {
            margin-bottom: 10px;
        }
        .polkadot-simulator-form label {
            margin-left: 5px;
        }
        .polkadot-simulator-table {
            width: 100%;
            border-collapse: collapse;
        }
        .polkadot-simulator-table th, .polkadot-simulator-table td {
            border: 1px solid #ddd;
            padding: 8px;
        }
        .polkadot-simulator-table th {
            background-color: #f2f2f2;
            text-align: left;
        }
        .polkadot-simulator-button {
            background-color: #e6007a;
            color: #fff;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
        }
        .polkadot-simulator-button:hover {
            background-color: #c50068;
        }
        .polkadot-simulator-reset-button {
            margin-top: 15px;
            display: inline-block;
        }
    ";
    wp_add_inline_style('polkadot_simulator_styles', $custom_css);
}
add_action('wp_enqueue_scripts', 'polkadot_simulator_enqueue_assets');

